rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Global Deny Catch-All
    match /{document=**} {
      allow read, write: if false;
    }

    // Global Helpers
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() > 0 && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // User Profile
    match /users/{userId} {
      allow get: if isOwner(userId);
      allow create, update: if isOwner(userId) && isValidId(userId);
      allow delete: if isOwner(userId);

      // Conversations Subcollection
      match /conversations/{conversationId} {
        allow read, write: if isOwner(userId) && isValidId(conversationId);

        // Messages Subcollection
        match /messages/{messageId} {
          allow read, write: if isOwner(userId) && isValidId(conversationId) && isValidId(messageId);
        }
      }

      // Memories Subcollection
      match /memories/{memoryId} {
        allow read, write: if isOwner(userId) && isValidId(memoryId);
      }
    }
  }
}
